+// Control Strip style slider: small round knob on a thin track tinted with the item's color,
+// between a small and a large symbol. Used by the brightness, keyboard backlight and volume
+// sliders when no knob image is given.
+extension Notification.Name {
+    static let sliderTouched = Notification.Name("com.toxblh.mtmr.sliderTouched")
+    static let sliderReleased = Notification.Name("com.toxblh.mtmr.sliderReleased")
+}
+
+final class RoundKnobSliderCell: NSSliderCell {
+    var tint: NSColor = .controlAccentColor
+    private let knobDiameter: CGFloat = 20
+
+    override func knobRect(flipped: Bool) -> NSRect {
+        let rect = super.knobRect(flipped: flipped)
+        return NSRect(x: rect.midX - knobDiameter / 2, y: rect.midY - knobDiameter / 2, width: knobDiameter, height: knobDiameter)
+    }
+
+    override func startTracking(at startPoint: NSPoint, in controlView: NSView) -> Bool {
+        NotificationCenter.default.post(name: .sliderTouched, object: nil)
+        return super.startTracking(at: startPoint, in: controlView)
+    }
+
+    override func stopTracking(last lastPoint: NSPoint, current stopPoint: NSPoint, in controlView: NSView, mouseIsUp flag: Bool) {
+        super.stopTracking(last: lastPoint, current: stopPoint, in: controlView, mouseIsUp: flag)
+        NotificationCenter.default.post(name: .sliderReleased, object: nil)
+    }
+
+    override func drawKnob(_ knobRect: NSRect) {
+        NSColor.white.setFill()
+        NSBezierPath(ovalIn: knobRect.insetBy(dx: 1, dy: 1)).fill()
+    }
+
+    override func drawBar(inside rect: NSRect, flipped _: Bool) {
+        let bar = NSRect(x: rect.minX, y: rect.midY - 2, width: rect.width, height: 4)
+        NSColor(white: 1, alpha: 0.25).setFill()
+        NSBezierPath(roundedRect: bar, xRadius: 2, yRadius: 2).fill()
+
+        var filled = bar
+        filled.size.width = bar.width * CGFloat((doubleValue - minValue) / (maxValue - minValue))
+        tint.setFill()
+        NSBezierPath(roundedRect: filled, xRadius: 2, yRadius: 2).fill()
+    }
+}
+
+func nativeSliderView(_ slider: NSSlider, minSymbol: String, maxSymbol: String, color: NSColor) -> NSView {
+    let color = AppSettings.monochrome ? NSColor.white : AppSettings.rainbow ? TouchBarController.shared.sliderTint ?? color : color
+    let cell = RoundKnobSliderCell()
+    cell.tint = color
+    cell.minValue = slider.minValue
+    cell.maxValue = slider.maxValue
+    cell.doubleValue = slider.doubleValue
+    cell.target = slider.target
+    cell.action = slider.action
+    cell.isContinuous = true
+    slider.cell = cell
+    return SliderPill(slider: slider, minSymbol: minSymbol, maxSymbol: maxSymbol, color: color)
+}
+
+// Slider and its close button on one rounded gray background, like a single Touch Bar control.
+final class SliderPill: NSView {
+    private let stack: NSStackView
+    private let closeButton: NSButton
+
+    // A right-aligned slider opens towards the left, so its close button goes first
+    var closeOnLeading = false {
+        didSet {
+            stack.removeView(closeButton)
+            if closeOnLeading { stack.insertView(closeButton, at: 0, in: .leading) } else { stack.addView(closeButton, in: .trailing) }
+        }
+    }
+
+    init(slider: NSSlider, minSymbol: String, maxSymbol: String, color: NSColor) {
+        func icon(_ name: String, _ size: CGFloat, _ color: NSColor) -> NSImage {
+            let configuration = NSImage.SymbolConfiguration(pointSize: size, weight: .medium)
+                .applying(NSImage.SymbolConfiguration(paletteColors: [color]))
+            return NSImage(systemSymbolName: name, accessibilityDescription: nil)?.withSymbolConfiguration(configuration) ?? NSImage()
+        }
+        func imageView(_ image: NSImage) -> NSImageView {
+            let view = NSImageView(image: image)
+            view.setContentHuggingPriority(.required, for: .horizontal)
+            view.setContentCompressionResistancePriority(.required, for: .horizontal)
+            return view
+        }
+
+        closeButton = NSButton(image: icon("xmark.circle.fill", 18, NSColor(white: 1, alpha: 0.55)), target: nil, action: nil)
+        closeButton.isBordered = false
+        closeButton.setContentHuggingPriority(.required, for: .horizontal)
+        stack = NSStackView(views: [imageView(icon(minSymbol, 12, color)), slider, imageView(icon(maxSymbol, 16, color)), closeButton])
+        stack.spacing = 14
+        stack.edgeInsets = NSEdgeInsets(top: 0, left: 12, bottom: 0, right: 10)
+        super.init(frame: .zero)
+
+        closeButton.target = self
+        closeButton.action = #selector(close)
+        wantsLayer = true
+        // Same gray and full height as the Touch Bar button bezels
+        layer?.backgroundColor = NSColor(srgbRed: 70 / 255, green: 70 / 255, blue: 70 / 255, alpha: 1).cgColor
+        layer?.cornerRadius = 6
+        heightAnchor.constraint(equalToConstant: 30).isActive = true
+
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        addSubview(stack)
+        NSLayoutConstraint.activate([
+            stack.leadingAnchor.constraint(equalTo: leadingAnchor),
+            stack.trailingAnchor.constraint(equalTo: trailingAnchor),
+            stack.topAnchor.constraint(equalTo: topAnchor),
+            stack.bottomAnchor.constraint(equalTo: bottomAnchor),
+        ])
+    }
+
+    required init?(coder _: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    @objc private func close() {
+        TouchBarController.shared.closeGroup()
+    }
+}
